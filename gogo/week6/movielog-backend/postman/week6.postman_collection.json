{
  "info": {
    "name": "6주차 Standard Mission",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "memberId",
      "value": "4"
    },
    {
      "key": "ratingId",
      "value": "4"
    }
  ],
  "item": [
    {
      "name": "01 회원가입 201",
      "request": {
        "method": "POST",
        "url": "http://localhost:8080/members",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mission6@example.com\",\n  \"nickname\": \"미션식스\",\n  \"password\": \"Study6!Demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) { pm.collectionVariables.set(\"memberId\",pm.response.json().result.memberId); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 평점 등록 201",
      "request": {
        "method": "POST",
        "url": "http://localhost:8080/members/{{memberId}}/ratings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 680,\n  \"score\": 5,\n  \"comment\": \"미션 인증 평점\"\n}",
          "options": {
