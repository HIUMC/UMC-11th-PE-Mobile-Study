            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) { pm.collectionVariables.set(\"ratingId\",pm.response.json().result); }"
            ]
          }
        }
      ]
    },
